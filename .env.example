# =====================================================================
# API keys — CHỈ dùng cho dev_server.js (key không gửi xuống trình duyệt)
# Copy file này thành .env rồi điền key thật.
#   PowerShell:  Copy-Item .env.example .env
#   Sau đó sửa .env
# =====================================================================

# AgentRouter — một key dùng cho: gpt-5.6-sol, gpt-6-astra, gpt-6.1-sol
# Lấy key ở https://agentrouter.org/console/token
AGENTROUTER_API_KEY=sk-...
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Bắt buộc để qua cổng client của AgentRouter (mặc định đã đúng, chỉ đổi khi cần)
# AGENTROUTER_UA=codex_cli_rs/0.40.0

# --- Model TẠO ẢNH (images/generations) ---
# Key chỉ dùng được model ảnh khi token đã được cấp quyền ở agentrouter.org/console/token
# (nhóm `default` hiện chưa có channel ảnh → gọi sẽ trả 503 "无可用渠道")
# AGENTROUTER_IMAGE_MODEL=dall-e-3
# AGENTROUTER_IMAGE_URL=https://agentrouter.org/v1/images/generations

# xKiro — text + image (api.xkiro.com/v1)
# XKIRO_API_KEY=sk-xt-3266d014a83b2bd15aed49882099d17d8614331135584cc1
# XKIRO_IMAGE_MODEL=openai/gpt-image-2.5

# APInex — text + image (api.apinex.bond/v1)
# APINEX_API_KEY=sk-apxf4783be73fde8089026d589c348b0528e7901b91973b007
# APINEX_IMAGE_MODEL=grok-imagine-2

# Tuỳ chọn
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# Kimi (Moonshot) — platform.kimi.ai, model: kimi-k2-0905 / kimi-latest
# KIMI_API_KEY=sk-4tLolVnkxe9MhuuUxk6vEUm4yC6trv6PVWd5Wb4eggZwsHK7
# KIMI_BASE_URL=https://platform.kimi.ai/v1

# Cổng server tĩnh (mặc định 5173)
# PORT=5173
