// Lấy current model và provider
let currentModelConfig = {
    provider: 'openai',
    model: 'gpt-4o-mini',
    fullId: 'openai:gpt-4o-mini'
};

function getAPIKey(provider) {
    return (localStorage.getItem(`pixi_${provider}_key`) || '').trim();
}

/* trạng thái proxy server (key trong .env) — chỉ khi chạy qua dev_server.js */
const ServerStatus = { provider: null, ready: false, checked: false };
async function checkServerStatus() {
    if (!/^https?:/.test(location.protocol)) { ServerStatus.checked = true; return ServerStatus; }
    try {
        const r = await fetch('/api/status');
        if (!r.ok) throw 0;
        ServerStatus.provider = await r.json();
        ServerStatus.checked = true;
        updateKeyBadge();
    } catch (e) { ServerStatus.checked = true; }
    return ServerStatus;
}
function serverHasKey(provider) {
    return !!(ServerStatus.provider && ServerStatus.provider[provider] && ServerStatus.provider[provider].ready);
}

function hasAPIKey() {
    const key = getAPIKey(currentModelConfig.provider);
    const providerCfg = AI_PROVIDERS[currentModelConfig.provider];
    return key.startsWith(providerCfg.keyPrefix) || serverHasKey(currentModelConfig.provider);
}

function openKeyModal() {
    const el = document.getElementById('api-modal');
    if (el) el.style.display = 'flex';
    
    // Load các keys đã lưu
    ['openai', 'deepseek', 'gemini', 'glm', 'agentrouter', 'xkiro', 'apinex', 'kimi', 'openrouter'].forEach(provider => {
        const input = document.getElementById(`input-${provider}-key`);
        if (input) input.value = getAPIKey(provider);
    });
    const arBase = document.getElementById('input-agentrouter-base');
    if (arBase) arBase.value = localStorage.getItem('pixi_agentrouter_base') || '';
    const dsBase = document.getElementById('input-deepseek-base');
    if (dsBase) dsBase.value = localStorage.getItem('pixi_deepseek_base') || '';
    const kimiBase = document.getElementById('input-kimi-base');
    if (kimiBase) kimiBase.value = localStorage.getItem('pixi_kimi_base') || '';
    const orBase = document.getElementById('input-openrouter-base');
    if (orBase) orBase.value = localStorage.getItem('pixi_openrouter_base') || '';
}

function closeKeyModal() {
    const el = document.getElementById('api-modal');
    if (el) el.style.display = 'none';
}

function saveAllKeys() {
    // Lưu tất cả keys
    ['openai', 'deepseek', 'gemini', 'glm', 'agentrouter', 'xkiro', 'apinex', 'kimi', 'openrouter'].forEach(provider => {
        const input = document.getElementById(`input-${provider}-key`);
        if (input) {
            const value = input.value.trim();
            if (value) {
                localStorage.setItem(`pixi_${provider}_key`, value);
            }
        }
    });
    const arBase = document.getElementById('input-agentrouter-base');
    if (arBase) {
        const v = arBase.value.trim();
        if (v) localStorage.setItem('pixi_agentrouter_base', v); else localStorage.removeItem('pixi_agentrouter_base');
    }
    
    // DeepSeek base URL tuỳ chọn
    const dsBase = document.getElementById('input-deepseek-base');
    if (dsBase) {
        const v = dsBase.value.trim();
        if (v) localStorage.setItem('pixi_deepseek_base', v); else localStorage.removeItem('pixi_deepseek_base');
    }
    
    // Kimi base URL tuỳ chọn
    const kimiBase = document.getElementById('input-kimi-base');
    if (kimiBase) {
        const v = kimiBase.value.trim();
        if (v) localStorage.setItem('pixi_kimi_base', v); else localStorage.removeItem('pixi_kimi_base');
    }

    // OpenRouter base URL tuỳ chọn
    const orBase = document.getElementById('input-openrouter-base');
    if (orBase) {
        const v = orBase.value.trim();
        if (v) localStorage.setItem('pixi_openrouter_base', v); else localStorage.removeItem('pixi_openrouter_base');
    }

    updateKeyBadge();
    updateModelBadge();
    closeKeyModal();
    toast('Đã lưu tất cả API keys');
}

function clearAllKeys() {
    ['openai', 'deepseek', 'gemini', 'glm', 'agentrouter', 'xkiro', 'apinex', 'kimi', 'openrouter'].forEach(provider => {
        localStorage.removeItem(`pixi_${provider}_key`);
        const input = document.getElementById(`input-${provider}-key`);
        if (input) input.value = '';
    });
    localStorage.removeItem('pixi_agentrouter_base');
    const arBase = document.getElementById('input-agentrouter-base');
    if (arBase) arBase.value = '';
    localStorage.removeItem('pixi_deepseek_base');
    const dsBase = document.getElementById('input-deepseek-base');
    if (dsBase) dsBase.value = '';
    localStorage.removeItem('pixi_kimi_base');
    const kimiBase = document.getElementById('input-kimi-base');
    if (kimiBase) kimiBase.value = '';
    localStorage.removeItem('pixi_openrouter_base');
    const orBase = document.getElementById('input-openrouter-base');
    if (orBase) orBase.value = '';
    
    updateKeyBadge();
    closeKeyModal();
    toast('Đã xoá tất cả API keys');
}

function changeModel(fullModelId) {
    const [provider, model] = fullModelId.split(':');
    currentModelConfig = {
        provider,
        model,
        fullId: fullModelId
    };
    
    // Lưu vào localStorage
    localStorage.setItem('pixi_current_model', fullModelId);
    
    updateKeyBadge();
    updateModelBadge();
    toast(`Đã chuyển sang model: ${AI_PROVIDERS[provider].name} - ${model}`);
}

function updateModelBadge() {
    const providerCfg = AI_PROVIDERS[currentModelConfig.provider];
    const badge = document.getElementById('current-model-badge');
    if (badge) {
        badge.textContent = currentModelConfig.model;
        badge.className = `text-[9px] px-1.5 py-0.5 rounded font-bold text-white ${providerCfg.color}`;
        badge.title = `Provider: ${providerCfg.name}`;
    }
    document.querySelectorAll('#chat-messages .ai-avatar').forEach(a => {
        a.textContent = providerCfg.icon;
        a.className = `ai-avatar w-7 h-7 rounded-full text-white grid place-items-center shrink-0 text-[10px] font-bold ${providerCfg.color}`;
    });
    
    // Cập nhật selector
    const selector = document.getElementById('model-selector');
    if (selector) selector.value = currentModelConfig.fullId;
}

function updateKeyBadge() {
    const ok = hasAPIKey();
    const viaServer = serverHasKey(currentModelConfig.provider);
    const b = document.getElementById('badge-api-mode');
    if (b) {
        b.textContent = ok ? (viaServer ? 'Live · .env' : 'Live') : 'Mock';
        b.className = `text-[9px] px-1.5 py-0.5 rounded font-bold text-white ${ok ? 'bg-emerald-600' : 'bg-amber-500'}`;
        b.title = viaServer ? 'Key lấy từ .env qua dev_server.js' : (ok ? 'Key lưu trong localStorage' : 'Chưa có key → mock mode');
    }
}

// Load model đã lưu khi khởi động
function loadSavedModel() {
    const saved = localStorage.getItem('pixi_current_model');
    if (saved) {
        const [provider, model] = saved.split(':');
        if (AI_PROVIDERS[provider] && AI_PROVIDERS[provider].models.includes(model)) {
            currentModelConfig = {
                provider,
                model,
                fullId: saved
            };
        }
    }
    updateModelBadge();
}

/* =====================================================================
   svg_character.js â€” load SVG nhÃ¢n váº­t (do AI sinh) thÃ nh rig Spine-style
   ---------------------------------------------------------------------
   CÃ¡ch hoáº¡t Ä‘á»™ng:
   1. Äá»c file SVG (knight_ai.svg). Má»—i <g id="..."> lÃ  1 bá»™ pháº­n (part).
   2. Vá»›i má»—i group: Ä‘o bbox (getBBox) â†’ táº¡o bone táº¡i Ä‘iá»ƒm neo (pivot),
      gáº¯n group Ä‘Ã³ vÃ o container bone (nhÆ° attachment).
   3. Skeleton = SpineSkeleton cÃ³ sáºµn (spine_rig.js), bone theo cÃ¢y giáº£i pháº«u.
   4. Animation: dÃ¹ng AnimationSystem cÃ³ sáºµn (clip idle/walk/attack...).
   ===================================================================== */

const SVG_BONES = [
    { name: 'root', parent: null, x: 0, y: 0, len: 20 },
    { name: 'hips', parent: 'root', x: 0, y: 0, len: 30 },
    { name: 'leg_upper_L', parent: 'hips', x: -18, y: 4, len: 55 },
    { name: 'leg_lower_L', parent: 'leg_upper_L', x: 0, y: 55, len: 50 },
    { name: 'foot_L', parent: 'leg_lower_L', x: 0, y: 50, len: 26 },
    { name: 'leg_upper_R', parent: 'hips', x: 18, y: 4, len: 55 },
    { name: 'leg_lower_R', parent: 'leg_upper_R', x: 0, y: 55, len: 50 },
    { name: 'foot_R', parent: 'leg_lower_R', x: 0, y: 50, len: 26 },
    { name: 'torso', parent: 'hips', x: 0, y: -28, len: 70 },
    { name: 'neck', parent: 'torso', x: 0, y: -64, len: 12 },
    { name: 'head', parent: 'neck', x: 0, y: 0, len: 60 },
    { name: 'arm_upper_L', parent: 'torso', x: -30, y: -52, len: 42 },
    { name: 'arm_lower_L', parent: 'arm_upper_L', x: 0, y: 42, len: 38 },
    { name: 'hand_L', parent: 'arm_lower_L', x: 0, y: 38, len: 24 },
    { name: 'arm_upper_R', parent: 'torso', x: 30, y: -52, len: 42 },
    { name: 'arm_lower_R', parent: 'arm_upper_R', x: 0, y: 42, len: 38 },
    { name: 'hand_R', parent: 'arm_lower_R', x: 0, y: 38, len: 24 },
    { name: 'weapon', parent: 'hand_R', x: 8, y: 0, len: 60, dir: -15 }
];

/** map tÃªn bone â†’ id group trong SVG (AI cÃ³ thá»ƒ Ä‘áº·t hÆ¡i khÃ¡c) */
const SVG_PART_ALIASES = {
    root: null, hips: ['hips', 'pelvis', 'hip'],
    torso: ['torso', 'chest', 'body'],
    neck: null, head: ['head', 'helmet', 'face'],
    arm_upper_L: ['arm_upper_L', 'arm_upper_left', 'upper_arm_L', 'arm_L', 'shoulder_L'],
    arm_lower_L: ['arm_lower_L', 'forearm_L', 'lower_arm_L'],
    hand_L: ['hand_L', 'fist_L', 'palm_L'],
    arm_upper_R: ['arm_upper_R', 'arm_upper_right', 'upper_arm_R', 'arm_R', 'shoulder_R'],
    arm_lower_R: ['arm_lower_R', 'forearm_R', 'lower_arm_R'],
    hand_R: ['hand_R', 'fist_R', 'palm_R'],
    leg_upper_L: ['leg_upper_L', 'thigh_L', 'upper_leg_L', 'leg_L'],
    leg_lower_L: ['leg_lower_L', 'shin_L', 'calf_L', 'lower_leg_L'],
    foot_L: ['foot_L', 'feet_L', 'boot_L'],
    leg_upper_R: ['leg_upper_R', 'thigh_R', 'upper_leg_R', 'leg_R'],
    leg_lower_R: ['leg_lower_R', 'shin_R', 'calf_R', 'lower_leg_R'],
    foot_R: ['foot_R', 'feet_R', 'boot_R'],
    weapon: ['sword', 'weapon', 'blade', 'weapon_blade']
};

const SvgCharacter = {
    loaded: false, groups: {}, boneById: {}, skel: null,

    /** parse text SVG â†’ DOM, tráº£ vá» map id group â†’ element (Ä‘Ã£ strip transform gá»‘c) */
    parse(svgText) {
        const doc = new DOMParser().parseFromString(svgText, 'image/svg+xml');
        const svg = doc.querySelector('svg');
        if (!svg) throw new Error('SVG khÃ´ng há»£p lá»‡');
        // xoÃ¡ script/style Ä‘á»ƒ an toÃ n
        svg.querySelectorAll('script, style, foreignObject').forEach(n => n.remove());
        const groups = {};
        svg.querySelectorAll('g[id]').forEach(g => { groups[g.id] = g; });
        // group khÃ´ng cÃ³ id nhÆ°ng náº±m trong group cÃ³ id â†’ Ä‘Ã£ náº±m trong groups cá»§a cha
        return { svg, groups };
    },

    /** Ä‘o bbox cá»§a 1 group (tÃ­nh cáº£ transform) â€” dÃ¹ng getBBox cá»§a chÃ­nh group trong svg táº¡m */
    measure(tempSvg, groupEl) {
        // groupEl Ä‘ang náº±m trong tempSvg (Ä‘Ã£ gáº¯n vÃ o DOM táº¡m) â†’ getBBox chÃ­nh xÃ¡c
        try {
            const b = groupEl.getBBox();
            return { x: b.x, y: b.y, w: b.width, h: b.height };
        } catch (e) { return null; }
    },

    /**
     * Load SVG â†’ build skeleton + gáº¯n part.
     * @param {string} svgText ná»™i dung file .svg
     * @param {EditorScene} scene scene PixiJS hiá»‡n táº¡i
     */
    async load(svgText, scene) {
        const { svg, groups } = this.parse(svgText);
        // svg táº¡m áº©n trong DOM Ä‘á»ƒ getBBox hoáº¡t Ä‘á»™ng
        const holder = document.createElement('div');
        // render đúng kích thước viewBox gốc, nếu không getBBox sẽ bị scale lệch
        const vbW = (svg.viewBox && svg.viewBox.baseVal && svg.viewBox.baseVal.width) || 200;
        const vbH = (svg.viewBox && svg.viewBox.baseVal && svg.viewBox.baseVal.height) || 300;
        holder.style.cssText = 'position:fixed;left:-9999px;top:0;width:' + vbW + 'px;height:' + vbH + 'px;';
        holder.appendChild(document.importNode(svg, true));
        document.body.appendChild(holder);
        const liveSvg = holder.querySelector('svg');
        const liveGroups = {};
        liveSvg.querySelectorAll('g[id]').forEach(g => { liveGroups[g.id] = g; });

        // 1) Ä‘o bbox cá»§a tá»«ng id group â†’ map boneName â†’ box (theo há»‡ toáº¡ Ä‘á»™ SVG)
        const boxes = {};
        for (const [boneName, ids] of Object.entries(SVG_PART_ALIASES)) {
            if (!ids) continue;
            for (const id of ids) {
                const el = liveGroups[id];
                if (!el) continue;
                const bb = this.measure(liveSvg, el);
                if (bb && bb.w > 1 && bb.h > 1) { boxes[boneName] = { id, ...bb }; break; }
            }
        }
        holder.remove();
        if (!boxes.torso || !boxes.head) throw new Error('SVG thiáº¿u part torso/head (cáº§n <g id="torso"> vÃ  <g id="head">)');

        /* 2) Dựng xương từ bbox THẬT của từng group (toạ độ tuyệt đối của SVG).
   Mỗi bone nằm ở KHỚP (đầu trên của part); part vẽ bằng frame tuyệt đối.
   Gốc chọn = tâm khung chậu (hips) để figure nằm quanh (0,0). */
const cx = b => b.x + b.w / 2;
const torso = boxes.torso;
const hipsB = boxes.hips || { x: torso.x + torso.w * 0.15, y: torso.y + torso.h * 0.82, w: torso.w * 0.7, h: torso.h * 0.18 };
const rootX = cx(hipsB);
const rootY = hipsB.y + hipsB.h * 0.5;
const headB = boxes.head;

const joint = {
    hips: { x: rootX, y: rootY },
    torso: { x: cx(torso), y: torso.y },
    neck: { x: cx(headB), y: headB.y + headB.h * 0.92 },
    head: { x: cx(headB), y: headB.y + headB.h * 0.92 }
};
['L', 'R'].forEach(function (sd) {
    var up = boxes['arm_upper_' + sd], lo = boxes['arm_lower_' + sd], hd = boxes['hand_' + sd];
    if (up) joint['arm_upper_' + sd] = { x: cx(up), y: up.y + up.h * 0.12 };
    if (lo) joint['arm_lower_' + sd] = { x: cx(lo), y: lo.y + lo.h * 0.08 };
    if (hd) joint['hand_' + sd] = { x: cx(hd), y: hd.y + hd.h * 0.1 };
    var lu = boxes['leg_upper_' + sd], ll = boxes['leg_lower_' + sd], ft = boxes['foot_' + sd];
    if (lu) joint['leg_upper_' + sd] = { x: cx(lu), y: lu.y + lu.h * 0.05 };
    if (ll) joint['leg_lower_' + sd] = { x: cx(ll), y: ll.y + ll.h * 0.05 };
    if (ft) joint['foot_' + sd] = { x: cx(ft), y: ft.y + ft.h * 0.15 };
});
if (boxes.weapon) joint.weapon = { x: cx(boxes.weapon), y: boxes.weapon.y + boxes.weapon.h * 0.55 };

const parentOf = { hips: 'root', torso: 'hips', neck: 'torso', head: 'neck', weapon: 'hand_R' };
['L', 'R'].forEach(function (sd) {
    parentOf['arm_upper_' + sd] = 'torso';
    parentOf['arm_lower_' + sd] = 'arm_upper_' + sd;
    parentOf['hand_' + sd] = 'arm_lower_' + sd;
    parentOf['leg_upper_' + sd] = 'hips';
    parentOf['leg_lower_' + sd] = 'leg_upper_' + sd;
    parentOf['foot_' + sd] = 'leg_lower_' + sd;
});

/* toạ độ LOCAL so với cha (đúng cách Spine làm) */
var defs = [{ name: 'root', parent: null, x: 0, y: 0, rotation: 0, length: 20 }];
Object.keys(joint).forEach(function (name) {
    if (name === 'root') return;
    var p = parentOf[name];
    var pj = joint[p] || { x: rootX, y: rootY };
    var boxOfName = boxes[name] || torso;
    defs.push({
        name: name, parent: p,
        x: +(joint[name].x - pj.x).toFixed(2),
        y: +(joint[name].y - pj.y).toFixed(2),
        rotation: 0,
        length: Math.max(6, Math.round(boxOfName.h || 20))
    });
});

        // 4) build skeleton
        const skel = new SpineSkeleton();
        skel.build(defs);
        /* SpineRig.applyPose() gọi thẳng skel.setupPose() mỗi khung hình; skeleton do
           SvgCharacter dựng trước đây thiếu hàm này (chỉ có setToSetupPose) nên phát clip
           là lỗi "skel.setupPose is not a function". Gán alias để phát animation được. */
        skel.setupPose = () => skel.setToSetupPose();

        // 5) render tá»«ng group SVG thÃ nh texture Pixi (SVG â†’ canvas qua Image)
        // rÃ  soÃ¡t kÃ­ch thÆ°á»›c váº½
        const vb = (svg.viewBox && svg.viewBox.baseVal) || { width: 400, height: 600 };
        const scale = 1.4;   // phÃ³ng nháº¹ cho rÃµ
        this.groups = {};
        this.boneById = {};
        let count = 0;
        for (const [boneName, box] of Object.entries(boxes)) {
            const gEl = liveGroups[box.id];
            if (!gEl) continue;
            const tex = await this.svgGroupToTexture(holder2 => holder2, gEl, box, scale, liveSvg, vb);
            if (!tex) continue;
            const bone = skel.bones.get(boneName);
            if (!bone) continue;
            const sp = new PIXI.Sprite(tex);
            // pivot = Ä‘iá»ƒm neo cá»§a part (nÆ¡i bone báº¯t Ä‘áº§u)
            const pivot = this.pivotFor(boneName, box);
            sp.anchor.set(0, 0);
            /* Sprite là con của container bone → toạ độ LOCAL so với khớp của bone.
               Nhờ vậy chỉ bone quyết định vị trí/xoay, part tự đúng chỗ như giấy cắt. */
            sp.pivot.set(0, 0);
            sp.rotation = 0;
            var jp = joint[boneName] || { x: rootX, y: rootY };
            /* Texture đã phóng to `scale` lần, nhưng sprite nằm trong hệ toạ độ SVG
               → phải thu nhỏ sprite lại 1/scale để khớp với bone. */
            sp.scale.set(1 / scale, 1 / scale);
            sp.pivot.set(jp.x - (box.x - 2), jp.y - (box.y - 2));
            sp.position.set(0, 0);
            sp.rotation = 0;
            sp.__joint = jp;
            bone.container.addChild(sp);
            bone.sprite = sp;
            bone.partKey = box.id;
            this.groups[boneName] = { id: box.id, box, sprite: sp };
            this.boneById[box.id] = boneName;
            count++;
        }
        this.skel = skel;
        this.loaded = count > 0;

        // 6) thay rig trong scene
        this.installIntoScene(scene, skel);
        return { skel, count, boxes };
    },

    /** render 1 group SVG â†’ PIXI.Texture báº±ng canvas (dÃ¹ng XMLSerializer + Image) */
    async svgGroupToTexture(_, gEl, box, scale, liveSvg, vb) {
        // serialize riÃªng group nÃ y thÃ nh 1 svg má»›i vá»›i cÃ¹ng viewBox Ä‘á»ƒ giá»¯ toáº¡ Ä‘á»™
        const clone = gEl.cloneNode(true);
        // texture = ĐÚNG BBOX của part (không lấy toàn khung), nên mỗi sprite chỉ chứa hình của nó
        const pad = 2;
        const vx = box.x - pad, vy = box.y - pad;
        const vw = box.w + pad * 2, vh = box.h + pad * 2;
        const w = Math.max(2, Math.ceil(vw * scale)), h = Math.max(2, Math.ceil(vh * scale));
        const svgStr = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vx} ${vy} ${vw} ${vh}" width="${w}" height="${h}">${new XMLSerializer().serializeToString(clone)}</svg>`;
        const url = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgStr);
        const img = new Image();
        await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
        const cv = document.createElement('canvas');
        cv.width = w; cv.height = h;
        cv.getContext('2d').drawImage(img, 0, 0);
        return PIXI.Texture.from(cv);
    },

    /** Ä‘iá»ƒm neo theo loáº¡i part (tá»‰ lá»‡ trong bbox) */
    pivotFor(boneName, box) {
        if (/^head/.test(boneName)) return [0.5, 0.92];          // cá»• á»Ÿ Ä‘Ã¡y Ä‘áº§u
        if (/^torso|body/.test(boneName)) return [0.5, 0.02];     // Ä‘á»‰nh thÃ¢n
        if (/^hips|pelvis/.test(boneName)) return [0.5, 0.10];
        if (/^leg_upper/.test(boneName)) return [0.5, 0.12];
        if (/^leg_lower/.test(boneName)) return [0.5, 0.08];
        if (/^foot/.test(boneName)) return [0.42, 0.15];
        if (/^arm_upper/.test(boneName)) return [boneName.endsWith('L') ? 0.18 : 0.82, 0.15];
        if (/^arm_lower/.test(boneName)) return [0.5, 0.10];
        if (/^hand/.test(boneName)) return [0.5, 0.15];
        if (/^weapon|sword/.test(boneName)) return [0.12, 0.5];   // chuÃ´i
        return [0.5, 0.5];
    },

    /** thay rigLayer trong scene báº±ng skeleton SVG */
    installIntoScene(scene, skel) {
        if (scene.rigLayer) scene.rigLayer.destroy({ children: true });
        scene.rigLayer = new PIXI.Container();
        scene.rigLayer.label = 'spine_layer_svg';
        scene.world.addChild(scene.rigLayer);
        scene.rigLayer.addChild(skel.bones.get('root').container);
        scene.spine = skel;
        scene.spineDebug = new PIXI.Graphics();
        scene.rigLayer.addChild(scene.spineDebug);
        scene.spineDebug.visible = (document.getElementById('chk-skeleton-toggle') || {}).checked ?? true;
        skel.setupPose = () => skel.setToSetupPose();
        skel.setupPose ? skel.setupPose() : skel.setToSetupPose();
        skel.updateWorldTransform();
        scene.rigReady = true;
        scene.drawSpineDebug();
        scene.layoutSpine();
        setText('bone-count', skel.ordered.length);
        renderSpineBonesList();
    }
};

/* publish trá»±c tiáº¿p lÃªn window cá»§a TRANG nÃ y (khÃ´ng dÃ¹ng defaultView/unsafeWindow) */
/* SvgCharacter dÃ¹ng trong cÃ¹ng scope engine */

/* ---------------------------------------------------------------------
   12. BOOT
   --------------------------------------------------------------------- */
function waitForLibs(timeout = 25000) {
    return new Promise(resolve => {
        const t0 = Date.now();
        const tick = () => {
            if (window.PIXI && window.PIXI.Application && window.SpineSkeleton) return resolve(true);
            if (Date.now() - t0 > timeout) return resolve(false);
            setTimeout(tick, 100);
        };
        tick();
    });
}

window.addEventListener('load', async () => {
    // export sớm: nếu boot ném lỗi / CDN chậm thì console vẫn dùng được engine
    Object.assign(window, { Engine, PartAtlas, ATLAS_PARTS, AutoNamer, SpineRig, Chat });
    window.Chat = Chat;
    checkServerStatus();
    loadSavedModel();
    updateKeyBadge();
    newChat();

    const ok = await waitForLibs();
    if (!ok) { setStatus('Không tải được PixiJS/Spine từ CDN'); return; }

    try {
        await Engine.boot();
        window.__RIG_DEBUG_HOOK = { Engine, SpineRig, PartAtlas, build: () => SpineRig.build(Engine.scene, false) };
        // ?demo=svg → tự rig nhân vật SVG (dùng để test/khởi động nhanh)
        if (/[?&]demo=svg/.test(location.search)) {
            const r = await fetch('knight_ai.svg').then(x => x.text()).catch(() => '');
            if (r) {
                const res = await SvgCharacter.load(r, Engine.scene);
                Engine.animation.loadClips(SVG_CLIPS(res.skel), true);
                setStatus(`DEMO SVG: ${res.count} parts · ${res.skel.ordered.length} bones`);
                if (/[?&]dump=1/.test(location.search)) {
                    const pre = document.createElement('pre');
                    pre.id = 'rig-dump';
                    pre.style.cssText = 'position:fixed;left:0;top:0;z-index:9999;font:10px monospace;background:#fff;max-height:40vh;overflow:auto';
                    pre.textContent = res.skel.ordered.map(b => `${b.name} q=(${b.qx.toFixed(1)},${b.qy.toFixed(1)}) rot=${b.qrot.toFixed(1)} spr=(${b.sprite ? b.sprite.position.x.toFixed(1) + ',' + b.sprite.position.y.toFixed(1) : '-'}) tex=${b.sprite ? Math.round(b.sprite.texture.width) + 'x' + Math.round(b.sprite.texture.height) : '-'}`).join('\n');
                    document.body.appendChild(pre);
                }
            }
        }
        addChatMessage('assistant',
            '**Xin chào!** Mình là trợ lý rig & animation (mô hình xương kiểu Spine) trong PixiJS v8.\n\n' +
            '- **Auto Rig (Spine)** ở sidebar để dựng lại skeleton\n' +
            '- **Auto name bộ phận** để tự nhận diện 27 part của atlas\n' +
            '- Nhắn mình để sinh rig/animation mới (cần OpenAI API key)');
    } catch (e) {
        console.error(e);
        // stack hiện luôn trong status để debug nhanh trên UI
        setStatus('Lỗi khởi động: ' + e.message + ' @ ' + String((e.stack || '').split('\n')[1] || '').trim());
    }

    // event wiring
    const bind = (id, ev, fn) => {
        const el = document.getElementById(id);
        if (el) el.addEventListener(ev, fn);
    };
    bind('select-bone-part', 'change', e => Engine.assignPart(e.target.value));
    bind('inp-x', 'change', () => Engine.applyBoneEdit());
    bind('inp-y', 'change', () => Engine.applyBoneEdit());
    bind('inp-rot', 'change', () => Engine.applyBoneEdit());
    bind('chat-input', 'keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChat(); }
    });
    bind('btn-send-chat', 'click', () => sendChat());
});

/* exports */
Object.assign(window, {
    Engine, PartAtlas, ATLAS_PARTS, AutoNamer, SpineRig, Chat,
    sendChat, quickPrompt, newChat, loadSession, toggleSidebar,
    autoNameParts, autoRigSpine, exportSpineJSON, downloadPackage,
    switchCharacter, togglePlayState, toggleSkeletonView,
    openKeyModal, closeKeyModal, saveAllKeys, clearAllKeys, updateKeyBadge,
    changeModel, updateModelBadge, loadSavedModel,
    applyAICode, applyAllAICode, applyAIJSON, applyAIRig, parseAIJSON, sanitizeClips, renderPartsLibrary, toast,
    deepseekProRig, fallbackModelConfig, autoPickRigModel, autoModelCandidates, providerReady,
    RIG_MODEL_PREFERENCE, askAndApply, PRO_RIG_PROMPT,
    AI_PROVIDERS, checkServerStatus, hasAPIKey, ServerStatus,
    aiCreateCharacter, aiGenerateRasterImage, aiGenerateSVG, SVG_CLIPS, SvgCharacter,
    // ảnh trong chat + viewer mở rộng
    ChatImages, ImageViewer, chatImageHtml, chatImageError, addChatMessage,
    renderMd, renderMdInline, renderMdBlock, copyCode,
    svgTextToDataUri, ensureSvgDisplaySize, decodeDataUriText, attrEsc
});

/* tab Parts / Assets */
function setLibraryTab(tab) {
    const tp = document.getElementById('tab-parts');
    const ta = document.getElementById('tab-assets');
    const tar = document.getElementById('tab-advanced-rig');
    const taa = document.getElementById('tab-anim-ai');
    const pp = document.getElementById('panel-parts');
    const pa = document.getElementById('panel-assets');
    const par = document.getElementById('advanced-rig-panel');
    const paa = document.getElementById('anim-ai-panel');
    const on = 'px-2 py-1 rounded bg-slate-900 text-white font-medium';
    const off = 'px-2 py-1 rounded hover:bg-slate-100 font-medium';
    if (tp) tp.className = tab === 'parts' ? on : off;
    if (ta) ta.className = tab === 'assets' ? on : off;
    if (tar) tar.className = tab === 'advanced' ? on : off;
    if (taa) taa.className = tab === 'anim' ? on : off;
    if (pp) pp.style.display = tab === 'parts' ? 'grid' : 'none';
    if (pa) pa.style.display = tab === 'assets' ? 'grid' : 'none';
    if (par) par.style.display = tab === 'advanced' ? 'block' : 'none';
    if (paa) paa.style.display = tab === 'anim' ? 'block' : 'none';
    if (tab === 'assets' && window.renderAssetLibrary) renderAssetLibrary();
    if (tab === 'anim' && window.AnimAI) AnimAI.render();
    // bảng Advanced Rig cần chỗ: mở rộng khối assets/bones khi đang ở tab này
    const block = document.getElementById('library-block');
    if (block) {
        block.classList.toggle('h-[240px]', tab !== 'advanced' && tab !== 'anim');
        block.classList.toggle('h-[430px]', tab === 'advanced' || tab === 'anim');
    }
    if (tab === 'advanced' || tab === 'anim') {
        if (tab === 'advanced' && window.RigAdvanced) RigAdvanced.render();
        // đổi chiều cao khối thư viện → viewport đổi → canh lại rig cho vừa khung
        if (Engine.app && Engine.scene && Engine.scene.layoutSpine) Engine.scene.layoutSpine();
    }
}
window.setLibraryTab = setLibraryTab;

/* tab Setup / Animate / Advanced (nút Advanced mở bảng rig nâng cao) */
function setWorkTab(tab) {
    const on = 'px-2.5 py-1.5 rounded-md bg-slate-900 text-white font-medium';
    const off = 'px-2.5 py-1.5 rounded-md hover:bg-slate-100 font-medium';
    ['setup', 'animate', 'advanced'].forEach(k => {
        const el = document.getElementById('tab-' + k);
        if (el) el.className = k === tab ? on : off;
    });
    // Advanced = bảng rig nâng cao; các tab khác giữ nguyên thư viện (Setup: Parts, Animate: Assets)
    setLibraryTab(tab === 'advanced' ? 'advanced' : (tab === 'anim' ? 'anim' : (tab === 'animate' ? 'assets' : 'parts')));
}
window.setWorkTab = setWorkTab;

/* khởi tạo drop zone sau khi DOM sẵn sàng */
if (window.initAssetDrop) {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAssetDrop);
    } else { initAssetDrop(); }
}

/* =====================================================================
   SVG CHARACTER RIG (gá»™p vÃ o engine Ä‘á»ƒ trÃ¡nh váº¥n Ä‘á» scope/thá»© tá»± script)
   ===================================================================== */